# Origen HTTPS oficial, sin ruta, para canonical, sitemap y URLs sociales.
# Configurarlo antes del build de producción.
SITE_URL=

# Solo para previews que no deban aparecer en buscadores: SITE_NOINDEX=true.
# Se permite el rastreo para que los buscadores puedan leer la directiva noindex.
SITE_NOINDEX=false